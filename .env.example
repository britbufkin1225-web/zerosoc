# ZeroSOC environment configuration example.
# Copy to .env and set real values. Do NOT commit your real .env file.
# Never put real secrets in this example file.

# REQUIRED: API key for protected endpoints.
# ZeroSOC refuses to start if this is unset or blank (whitespace-only counts
# as blank). Use a long random secret.
ZEROSOC_API_KEY=replace-with-a-long-random-secret

# OPTIONAL: Network interface to bind to.
# Default (when unset) is 127.0.0.1 (localhost only) — safest.
# Set to 0.0.0.0 ONLY on a trusted home-lab network.
# WARNING: 0.0.0.0 exposes ZeroSOC to every device on your local network.
# ZEROSOC_HOST=127.0.0.1
# ZEROSOC_HOST=0.0.0.0

# OPTIONAL: Comma-separated list of browser origins allowed to make
# cross-origin requests to the API (CORS). Defaults to the local dashboard
# origins http://localhost:5500 and http://127.0.0.1:5500. A wildcard is
# never used. When serving the dashboard from another host/port (for example
# a home-lab LAN address), add that exact origin here.
# ZEROSOC_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# OPTIONAL: Alert webhook URL (leave blank to disable webhook notifications).
ZEROSOC_ALERT_WEBHOOK_URL=

# OPTIONAL: Cooldown (seconds) between duplicate alert notifications.
ZEROSOC_ALERT_NOTIFICATION_COOLDOWN_SECONDS=900
